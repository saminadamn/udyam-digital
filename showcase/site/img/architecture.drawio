d="e11" value="WhatsApp updates to opted-in owners" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#6f6d66;fontSize=11;fontStyle=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1356" y="608" as="sourcePoint"/><mxPoint x="30" y="418" as="targetPoint"/><Array as="points"><mxPoint x="1356" y="860"/><mxPoint x="15" y="860"/><mxPoint x="15" y="418"/></Array></mxGeometry></mxCell><mxCell id="title" value="&lt;b&gt;Udyam Digital · system architecture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#6f6d66&quot;&gt;AI handles acquisition; humans handle exceptions. Rules decide eligibility; the LLM only explains.&lt;/font&gt;" style="text;html=1;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="56" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Red dashed: personal data masked / encrypted&lt;br&gt;Amber: a person steps in&lt;br&gt;Grey dashed: swappable provider (mock in demo)&lt;br&gt;Blue: people" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#4d4c48;" vertex="1" parent="1"><mxGeometry x="30" y="740" width="420" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>