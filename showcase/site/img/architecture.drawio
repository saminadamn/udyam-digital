</mxCell><mxCell id="wa" value="&lt;b&gt;WhatsApp&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Opt-in status updates&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf2fc;strokeColor=#2a78d6;fontColor=#0d2f5c;fontSize=13;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="200" height="76" as="geometry"/></mxCell><mxCell id="staff" value="&lt;b&gt;Staff&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Agents · admin&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf2fc;strokeColor=#2a78d6;fontColor=#0d2f5c;fontSize=13;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="610" width="200" height="76" as="geometry"/></mxCell><mxCell id="app" value="&lt;b&gt;Customer app&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Advisor · quote · consent&lt;br&gt;KYC · tracker&lt;br&gt;Web Speech API (voice)&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#9a978e&#x27; style=&#x27;font-size:9px&#x27;&gt;&lt;b&gt;SHOWS MASKED IDs ONLY&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9a978e;fontColor=#141414;fontSize=13;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="275" y="112" width="210" height="132" as="geometry"/></mxCell><mxCell id="con" value="&lt;b&gt;Admin console&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Leads · escalations&lt;br&gt;Outbox · simulator&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#9a978e&#x27; style=&#x27;font-size:9px&#x27;&gt;&lt;b&gt;AUDIT-LOGGED VIEWS&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9a978e;fontColor=#141414;fontSize=13;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="275" y="592" width="210" height="112" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;API · FastAPI&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;HTTPS + JWT roles&lt;br&gt;Rate limits&lt;br&gt;PII-scrubbed logs&lt;br&gt;Masked responses&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#c8102e&#x27; style=&#x27;font-size:9px&#x27;&gt;&lt;b&gt;MASKS IDs&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff5f6;strokeColor=#c8102e;fontColor=#141414;fontSize=13;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="530" y="300" width="190" height="200" as="geometry"/></mxCell><mxCell id="adv" value="&lt;b&gt;Advisor&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;LLM explains&lt;br&gt;Rules engine decides&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9a978e;fontColor=#141414;fontSize=13;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="785" y="112" width="210" height="112" as="geometry"/></mxCell><mxCell id="pri" value="&lt;b&gt;Pricing&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;One monthly price&lt;br&gt;Dependency locks&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9a978e;fontColor=#141414;fontSize=13;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1020" y="112" width="200" height="112" as="geometry"/></mxCell><mxCell id="kyc" value="&lt;b&gt;Smart KYC&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Consent first&lt;br&gt;GSTIN / Udyam lookup&lt;br&gt;OCR → 13 checks&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#c8102e&#x27; style=&#x27;font-size:9px&#x27;&gt;&lt;b&gt;ENCRYPTS DOCS + IDs&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff5f6;strokeColor=#c8102e;fontColor=#141414;fontSize=13;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="785" y="250" width="210" height="112" as="geometry"/></mxCell><mxCell id="notf" value="&lt;b&gt;Notifications&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;8-language templates&lt;br&gt;Opt-in enforced&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9a978e;fontColor=#141414;fontSize=13;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1020" y="250" width="200" height="112" as="geometry"/></mxCell><mxCell id="ord" value="&lt;b&gt;Orders &amp;amp; tracker&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;State machine · dates&lt;br&gt;SLA escalation job&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9a978e;fontColor=#141414;fontSize=13;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="785" y="388" width="210" height="112" as="geometry"/></mxCell><mxCell id="adm" value="&lt;b&gt;Admin analytics&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Propensity model&lt;br&gt;Live pilot metrics&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9a978e;fontColor=#141414;fontSize=13;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1020" y="388" width="200" height="112" as="geometry"/></mxCell><mxCell id="q" value="&lt;b&gt;Agent queue: humans step in&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;KYC review · late install · advisor stuck · &amp;quot;talk to a person&amp;quot;&lt;br&gt;Assigned to the least-loaded agent who speaks the customer&amp;#x27;s language&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff3df;strokeColor=#b8780a;fontColor=#3d2a00;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="785" y="592" width="435" height="112" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;SQLite&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;PII columns encrypted (Fernet)&lt;br&gt;Phone stored as keyed hash&lt;br&gt;Events · consents · audit log&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#c8102e&#x27; style=&#x27;font-size:9px&#x27;&gt;&lt;b&gt;ENCRYPTED AT REST&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff5f6;strokeColor=#c8102e;fontColor=#141414;fontSize=13;strokeWidth=2;dashed=1;shape=cylinder3;boundedLbl=1;size=10;" vertex="1" parent="1"><mxGeometry x="1290" y="112" width="280" height="132" as="geometry"/></mxCell><mxCell id="fs" value="&lt;b&gt;Document store&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Each file encrypted&lt;br&gt;Deleted 90 days after verify&lt;br&gt;(30 if abandoned)&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#c8102e&#x27; style=&#x27;font-size:9px&#x27;&gt;&lt;b&gt;AUTO-DELETED&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff5f6;strokeColor=#c8102e;fontColor=#141414;fontSize=13;strokeWidth=2;dashed=1;shape=cylinder3;boundedLbl=1;size=10;" vertex="1" parent="1"><mxGeometry x="1290" y="290" width="280" height="112" as="geometry"/></mxCell><mxCell id="llm" value="&lt;b&gt;LLM&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;explains only&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f3f1eb;strokeColor=#aaa79e;fontColor=#4d4c48;fontSize=13;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1290" y="470" width="132" height="60" as="geometry"/></mxCell><mxCell id="reg" value="&lt;b&gt;GSTIN / Udyam&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;registries (mock)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f3f1eb;strokeColor=#aaa79e;fontColor=#4d4c48;fontSize=13;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1438" y="470" width="132" height="60" as="geometry"/></mxCell><mxCell id="tw" value="&lt;b&gt;Twilio&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;or mock outbox&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f3f1eb;strokeColor=#aaa79e;fontColor=#4d4c48;fontSize=13;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1290" y="548" width="132" height="60" as="geometry"/></mxCell><mxCell id="sp" value="&lt;b&gt;Speech API&lt;/b&